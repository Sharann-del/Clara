{
  "name": "@clara/api",
  "version": "0.1.1",
  "private": true,
  "description": "Clara REST API (Fastify) — talks to RDS Postgres, verifies Cognito JWTs",
  "keywords": [
    "fastify",
    "aws-lambda",
    "postgresql",
    "cognito",
    "websocket"
  ],
  "homepage": "https://github.com/Sharann-del/Clara#readme",
  "bugs": {
    "url": "https://github.com/Sharann-del/Clara/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sharann-del/Clara.git",
    "directory": "packages/api"
  },
  "license": "MIT",
  "author": "Sharann M",
  "contributors": [
    "Dhriti"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1155.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1155.0",
    "@aws-sdk/client-dynamodb": "^3.1155.0",
    "@aws-sdk/client-secrets-manager": "^3.1155.0",
    "@aws-sdk/lib-dynamodb": "^3.1155.0",
    "@fastify/aws-lambda": "^6.4.2",
    "@fastify/cors": "^11.3.1",
    "aws-jwt-verify": "^4.0.1",
    "fastify": "^5.1.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7",
    "@clara/shared": "*"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3"
  }
}
