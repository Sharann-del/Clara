# @clara/api: local development settings.
# Copy to packages/api/.env, fill in your own values, then load it before starting the API:
#   set -a; . packages/api/.env; set +a; npm run api:dev
# Deployed Lambdas never read this file. CDK sets their environment, and they resolve the
# database from DB_SECRET_ARN through Secrets Manager instead of a plaintext DATABASE_URL.
# Every variable is described in docs/configuration.md.

# Port for the local Fastify server.
PORT=3001

# A local PostgreSQL 16 database (run `npm run api:migrate` once to create the schema).
DATABASE_URL=postgres://clara:clara-local-password@localhost:5432/clara

# Alternatively, resolve credentials from the deployed RDS secret. This only works from
# somewhere that can reach the private subnets, for example an SSM port-forwarding session.
# DB_SECRET_ARN=arn:aws:secretsmanager:eu-north-1:123456789012:secret:clara/rds/admin-AbCdEf
# DB_NAME=clara

# Cognito user pool and web client, from the UserPoolId and UserPoolClientId stack outputs.
USER_POOL_ID=eu-north-1_ExamplePool
USER_POOL_CLIENT_ID=1example23clientid456abcde
AWS_REGION=eu-north-1

# Browser origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:5173

# Used only by the WebSocket Lambdas (src/ws). CDK sets them on deploy; the local REST
# server ignores them.
# CONNECTIONS_TABLE=ClaraStack-RealtimeConnectionsED6B0391-1A2B3C4D5E6F
# WS_MANAGEMENT_ENDPOINT=https://f6g7h8i9j0.execute-api.eu-north-1.amazonaws.com/prod
# WS_MAX_CONNECTIONS_PER_USER=10
# WS_MAX_CONNECTIONS_PER_ROOM=25
