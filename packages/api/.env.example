# Local dev only. Copy to .env.local and source it, or export manually.
# Real deployments never use a plaintext DATABASE_URL — they resolve
# DB_SECRET_ARN via Secrets Manager at runtime instead (see src/db.ts).

PORT=3001

# Point at a local Postgres 16 for fast local iteration:
DATABASE_URL=postgres://clara:clara@localhost:5433/clara

# Or, to run the API locally against the *real* deployed RDS instance instead
# (only works from network locations that can reach the private subnet, e.g.
# via SSM port forwarding — the API itself, running as a deployed Lambda,
# reaches it directly):
# DB_SECRET_ARN=arn:aws:secretsmanager:eu-north-1:...:secret:clara/rds/admin-xxxxx
# DB_NAME=clara

USER_POOL_ID=eu-north-1_ExamplePool
USER_POOL_CLIENT_ID=1example23clientid456abcde
AWS_REGION=eu-north-1

CORS_ORIGINS=http://localhost:5173
