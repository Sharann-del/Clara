# @clara/frontend: build-time settings (Vite inlines every VITE_* value into the bundle,
# so never put a secret here). Copy to packages/frontend/.env and replace the example values
# with your stack outputs (see docs/self-hosting-aws.md). Every variable is described in
# docs/configuration.md.

# REST API base URL: the ApiUrl output, or http://localhost:3001 for a local API.
VITE_API_URL=https://a1b2c3d4e5.execute-api.eu-north-1.amazonaws.com

# Realtime WebSocket URL: the WebSocketUrl output.
VITE_WS_URL=wss://f6g7h8i9j0.execute-api.eu-north-1.amazonaws.com/prod

# Cognito user pool and web client: the UserPoolId and UserPoolClientId outputs.
VITE_USER_POOL_ID=eu-north-1_ExamplePool
VITE_USER_POOL_CLIENT_ID=1example23clientid456abcde
VITE_AWS_REGION=eu-north-1

# Public origin of the deployed site (FrontendUrl output or a custom domain), no trailing
# slash. Used for absolute Open Graph URLs, sitemap.xml, robots.txt and the MCP docs.
VITE_SITE_URL=https://d1example2cdn3.cloudfront.net

# Set to true when the stack is deployed with signupMode=invite, to show an invite-code field.
VITE_SIGNUP_INVITE_REQUIRED=false

# Playwright (npm run e2e) reads these from the shell, not from this file:
#   E2E_BASE_URL=http://localhost:5173       site under test
#   E2E_USER_POOL_ID=eu-north-1_ExamplePool  enables the signed-in tests (needs AWS credentials
#                                            allowed to admin-confirm and delete users)
#   E2E_EMAIL_DOMAIN=example.com             domain for throwaway sign-up addresses
