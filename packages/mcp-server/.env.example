# @clara/mcp-server: settings for the integration scripts in scripts/.
# The deployed MCP Lambda gets DB_SECRET_ARN and DB_NAME from CDK and never reads this file.
# Every variable is described in docs/configuration.md.

# scripts/local.ts: a scratch local database (the script creates and deletes its own rows).
# scripts/sharing-e2e.ts: the same database the running API uses, since MCP calls go
# straight through the handler.
DATABASE_URL=postgres://clara:clara-local-password@localhost:5432/clara

# scripts/sharing-e2e.ts: a running API and Cognito ID tokens for two different test users.
API_URL=http://localhost:3001
TOKEN_A=eyJraWQiOiJleGFtcGxlLWtleS1hIiwiYWxnIjoiUlMyNTYifQ.example-user-a.signature
TOKEN_B=eyJraWQiOiJleGFtcGxlLWtleS1iIiwiYWxnIjoiUlMyNTYifQ.example-user-b.signature

# scripts/e2e.ts (npm run e2e): runs against a deployed stack. Values left unset are read
# from the ClaraStack outputs with the active AWS profile, which must be allowed to
# admin-confirm and delete Cognito users.
AWS_REGION=eu-north-1
AWS_PROFILE=clara-admin
# API_URL=https://a1b2c3d4e5.execute-api.eu-north-1.amazonaws.com
# MCP_URL=https://a1b2c3d4e5.execute-api.eu-north-1.amazonaws.com/mcp
# USER_POOL_ID=eu-north-1_ExamplePool
# USER_POOL_CLIENT_ID=1example23clientid456abcde
